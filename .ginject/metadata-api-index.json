{
  "format": "ai-metadata-v1",
  "purpose": "Machine-readable API index for Ginject framework",
  "packages": {
    "core": {
      "responsibility": "Application lifecycle, handler invocation, DI container",
      "public_types": {
        "App": {
          "description": "Main application container",
          "methods": [
            {
              "name": "New",
              "signature": "New() *App",
              "purpose": "Create new app instance"
            },
            {
              "name": "Create",
              "signature": "Create(m *Module)",
              "purpose": "Initialize app with module tree (MUST call once)"
            },
            {
              "name": "Listen",
              "signature": "Listen(port int)",
              "purpose": "Start HTTP server on port"
            },
            {
              "name": "ServeHTTP",
              "signature": "ServeHTTP(w ResponseWriter, r *Request)",
              "purpose": "HTTP handler (auto-called by Go stdlib)"
            },
            {
              "name": "BindGlobalMiddlewares",
              "signature": "BindGlobalMiddlewares(fn ...MiddlewareFn)",
              "purpose": "Register middlewares for all routes"
            },
            {
              "name": "EnableWS",
              "signature": "EnableWS(config *WSConfig)",
              "purpose": "Enable WebSocket support"
            },
            {
              "name": "SetMaxBodySize",
              "signature": "SetMaxBodySize(bytes int64)",
              "purpose": "Set max HTTP request body size"
            }
          ]
        },
        "Module": {
          "description": "Composition root for controllers and providers with lifecycle hooks",
          "fields": [
            "providers []Provider",
            "controllers []Controller",
            "imports []*Module",
            "HTTPMainHandlers []HTTPMainHandler",
            "WSHandlers []WSHandler",
            "OnReady func() - Called after app.Create() completes (v2.0+)",
            "OnShutdown func() - Called on app shutdown (SIGINT/SIGTERM) (v2.0+)"
          ]
        },
        "ModuleBuilder": {
          "description": "Fluent API for building modules",
          "methods": [
            "Controllers(...) *ModuleBuilder",
            "Providers(...) *ModuleBuilder",
            "Imports(...) *ModuleBuilder",
            "Export(...) *ModuleBuilder",
            "IsGlobal(bool) *ModuleBuilder",
            "Build() *Module"
          ]
        },
        "Provider": {
          "description": "Any struct implementing NewProvider() Provider",
          "interface": "type Provider interface { NewProvider() Provider }"
        }
      },
      "initialization_order": [
        "initLogger",
        "initProviders",
        "initWS",
        "initMiddlewares",
        "initExceptionFilters",
        "initGuards",
        "initInterceptors",
        "initMainHandlers",
        "initDevtool",
        "initAccessLog"
      ]
    },
    "ctx": {
      "responsibility": "Request context objects and dependency types",
      "public_types": {
        "HTTPContext": {
          "description": "HTTP request context (pooled)",
          "methods": [
            "Init(ResponseWriter, *Request)",
            "InitWithMaxBodySize(ResponseWriter, *Request, int64)",
            "Status(code int) *HTTPContext",
            "SetDeadline(duration time.Duration) *HTTPContext",
            "IsDeadlineExceeded() bool",
            "Text(data string) void",
            "JSON(data any) void",
            "GetID() string"
          ]
        },
        "WSContext": {
          "description": "WebSocket request context (pooled)",
          "methods": [
            "Init(*websocket.Conn)",
            "WSPayload() *WSPayload",
            "GetID() string"
          ]
        }
      },
      "http_dependencies": [
        "*ctx.HTTPContext",
        "*http.Request",
        "http.ResponseWriter",
        "ctx.Body",
        "ctx.Query",
        "ctx.Header",
        "ctx.Param",
        "ctx.Form",
        "ctx.File",
        "ctx.Next",
        "ctx.Redirect",
        "common.Publisher"
      ],
      "ws_dependencies": [
        "*ctx.WSContext",
        "*websocket.Conn",
        "ctx.WSPayload",
        "ctx.Next",
        "common.Publisher"
      ]
    },
    "common": {
      "responsibility": "Pipeline interfaces and embedded controller types",
      "interfaces": {
        "MiddlewareFn": "func(*http.Request, http.ResponseWriter, ctx.Next)",
        "Guarder": "interface { CanActivate(*ctx.HTTPContext) bool }",
        "Interceptable": "interface { Intercept(*ctx.HTTPContext, *aggregation.Aggregation) any }",
        "ExceptionFilterable": "interface { Catch(*exception.Exception, *ctx.HTTPContext) }",
        "Logger": "interface { Log(level string, data any); LogStructured(...) }",
        "Publisher": "interface { Publish(topic string, data any) error }"
      },
      "embedded_types": {
        "REST": "Embed in controller to enable HTTP routing",
        "WS": "Embed in controller to enable WebSocket routing"
      }
    },
    "routing": {
      "responsibility": "HTTP routing and path matching",
      "routing_tokens": {
        "http_methods": {
          "READ": "GET",
          "CREATE": "POST",
          "UPDATE": "PUT",
          "MODIFY": "PATCH",
          "DELETE": "DELETE",
          "PREFLIGHT": "OPTIONS"
        },
        "path_separators": {
          "BY": "path parameter (`:paramName`)",
          "AND": "additional path segment",
          "OF": "sub-resource",
          "ANY": "wildcard segment",
          "FILE": "file serving"
        },
        "versioning": {
          "VERSION_X": "API version tag (e.g., VERSION_1, VERSION_2)"
        }
      },
      "examples": {
        "READ_BY_ID": "GET /:id",
        "READ_BY_ID_AND_NAME": "GET /:id/:name",
        "CREATE_OF_COMMENTS": "POST /comments",
        "DELETE_BY_ID_VERSION_2": "DELETE /v2/:id",
        "READ_ANY": "GET /*"
      }
    },
    "exception": {
      "responsibility": "Exception types and error handling",
      "Exception": {
        "methods": [
          "GetCode() int",
          "GetMessage() string",
          "GetStatusText() string",
          "GetStackTrace() string",
          "SetStackTrace(trace string)"
        ]
      },
      "built_in_exceptions": [
        "BadRequestException (400)",
        "UnauthorizedException (401)",
        "ForbiddenException (403)",
        "NotFoundException (404)",
        "ConflictException (409)",
        "InternalServerErrorException (500)",
        "RequestTimeoutException (408)",
        "NotImplementedException (501)",
        "ServiceUnavailableException (503)"
      ]
    },
    "event": {
      "responsibility": "Event emission and tracing",
      "public_types": {
        "Event": {
          "methods": [
            "On(name string, fn func(any)) void",
            "Emit(name string, data any) void",
            "HasListeners(name string) bool"
          ]
        }
      }
    },
    "trace": {
      "responsibility": "Request tracing and observability",
      "trace_stages": [
        "handshake",
        "middleware",
        "guard",
        "interceptor",
        "pipe",
        "handler",
        "filter",
        "complete"
      ],
      "transports": ["http", "ws"]
    },
    "memorybroker": {
      "responsibility": "Lightweight in-process topic-based pub/sub broker (no queue groups, no persistence, no ack/retry)",
      "public_types": {
        "Broker": {
          "description": "Publisher-subscriber message broker interface",
          "methods": [
            "Subscribe(topic string, handler MessageHandler) (Subscription, error)",
            "Unsubscribe(sub Subscription) error",
            "Publish(topic string, payload any) error",
            "PublishAsync(topic string, payload any) error",
            "Close() error"
          ],
          "removed_in_simplification": [
            "Once(topic, handler)", "SubscribeQueue(topic, group, handler)",
            "Off(topic)", "ListenerCount(topic)", "Topics()", "Clear()", "Stats()"
          ]
        },
        "Message": {
          "description": "Published message (no ID, no Metadata — removed in simplification)",
          "fields": [
            "Topic string - Topic name",
            "Payload any - Message data",
            "Timestamp time.Time - captured via time.Now() before dispatch"
          ]
        },
        "Subscription": {
          "description": "Subscription handle for cleanup",
          "methods": [
            "ID() string",
            "Topic() string",
            "Unsubscribe() error"
          ]
        },
        "MessageHandler": {
          "description": "func(msg *Message) - Handler invoked on publish"
        },
        "sentinel_errors": [
          "ErrClosed", "ErrNilHandler", "ErrEmptyTopic", "ErrForeignSubscription"
        ]
      },
      "pattern_types": [
        "Exact: 'user.login' - O(1) map lookup, matches only that topic",
        "Suffix: 'user.*' - O(1) map lookup by prefix; greedy, matches ANY depth below 'user.', not just one level",
        "Global: '*' - O(1), matches all topics. '*' is the ONLY wildcard token; '>' is NOT special-cased (verified empirically) - a pattern containing '>' matches only that literal string",
        "Complex: 'user.*.profile', '*.created' - O(n) scan; segment-wildcard matching, NOT regex"
      ],
      "key_features": [
        "Single sync.RWMutex over 4 maps (exact/prefix/global/complex) - no sharding",
        "PublishAsync: one goroutine per call tracked by sync.WaitGroup, no worker pool/bounded queue",
        "Close(): CompareAndSwap-idempotent, waits for in-flight PublishAsync via WaitGroup, then clears all maps",
        "Cross-broker Unsubscribe protection via ErrForeignSubscription (checks subscription.broker == receiver)",
        "Unsubscribe(nil) is always nil, unconditionally, even after Close",
        "Unconditional panic recovery per handler call (not configurable, no OnPanic hook)",
        "publishInternal sizes handler slice exactly, skips allocation entirely when nothing matches"
      ]
    },
    "memorycache": {
      "responsibility": "In-memory LFU cache with optional file-based persistence",
      "public_types": {
        "MemoryCache": {
          "description": "In-memory cache with sharded architecture and persistence",
          "constructors": [
            "NewMemoryCache() *MemoryCache - Create cache (persistence disabled)",
            "NewMemoryCacheWithConfig(cfg PersistenceConfig) *MemoryCache - Create with persistence"
          ],
          "methods": [
            "Get(ctx, key string) ([]byte, bool)",
            "Set(ctx, key string, val []byte, ttl time.Duration) error",
            "SetNX(ctx, key string, val []byte, ttl time.Duration) (bool, error)",
            "Delete(ctx, key string) error",
            "Keys(ctx) []string",
            "TTL(ctx, key string) (time.Duration, bool)",
            "Stop() - Flush and close (calls OnShutdown)"
          ]
        },
        "PersistenceConfig": {
          "description": "Configuration for file-based persistence",
          "fields": [
            "Enabled bool - Enable/disable persistence",
            "FilePath string - Path to persistence file",
            "FlushInterval time.Duration - Periodic flush interval (0 = manual)"
          ]
        }
      },
      "persistence_features": [
        "JSON format for human debuggability",
        "Atomic writes (temp file → rename)",
        "Automatic expiration filtering on save/load",
        "TTL preservation across restarts",
        "Dirty-state tracking with atomic operations",
        "Periodic background flushing (configurable)",
        "Graceful handling of missing/corrupt files"
      ],
      "key_characteristics": [
        "Sharded (256 shards) for concurrent R/W",
        "LFU eviction on cleanup",
        "Automatic background sweep every 5s/256 shards",
        "Thread-safe all operations",
        "Context-based API (conforms to cache interface)"
      ]
    }
  },
  "critical_rules": [
    "NEVER hold onto context after request completes",
    "NEVER mutate context after guard stage",
    "NEVER call provider.NewProvider() manually",
    "NEVER panic in guard (return bool instead)",
    "NEVER call next() multiple times in middleware",
    "NEVER access raw websocket.Conn in handlers (use Publisher)",
    "NEVER retain pooled objects beyond request lifetime",
    "Module initialization order is SACRED - do not reorder"
  ],
  "common_mistakes": [
    "Type mismatch between provider and handler parameter",
    "Circular dependencies causing runtime panics",
    "Calling next() multiple times in middleware",
    "Panicking in guard layer",
    "Retaining context references after request",
    "Not implementing NewProvider() interface",
    "Assuming message ordering in WebSocket",
    "Slow clients causing message drops in WebSocket"
  ]
}
